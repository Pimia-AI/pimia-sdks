# Tenant de Pimia al que se conecta la app (un tenant = un AS + una API).
PIMIA_BASE_URL=https://acme.pimia.es

# Client registrado EN ESE TENANT con token_endpoint_auth_method=client_secret_post
# (ver README). El secret vive solo en el servidor: nunca NEXT_PUBLIC_*.
PIMIA_CLIENT_ID=mcp_xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
PIMIA_CLIENT_SECRET=pcs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# URL pública de ESTA app. El callback registrado debe ser <APP_URL>/callback.
APP_URL=http://localhost:3000

# Firma de las cookies de sesión: openssl rand -base64 32
SESSION_SECRET=cambia-esto-por-32-bytes-aleatorios

# Solo desarrollo: carpeta donde el starter guarda los tokens (sustituye el
# FileTokenStore por tu BD en producción).
# PIMIA_TOKEN_DIR=./.tokens
