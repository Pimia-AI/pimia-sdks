{
    "name": "pimia/pimia-php",
    "description": "Cliente PHP de la API de Pimia para apps de partner: OAuth con PKCE, rotación de refresh persistida, reintentos de rate limit y excepciones tipadas.",
    "type": "library",
    "license": "MIT",
    "keywords": ["pimia", "facturacion", "verifactu", "oauth", "sdk"],
    "homepage": "https://github.com/Pimia-AI/pimia-sdks/tree/main/php",
    "authors": [
        {
            "name": "Pimia",
            "homepage": "https://pimia.es"
        }
    ],
    "support": {
        "issues": "https://github.com/Pimia-AI/pimia-sdks/issues",
        "source": "https://github.com/Pimia-AI/pimia-sdks"
    },
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0"
    },
    "require-dev": {
        "guzzlehttp/guzzle": "^7.8",
        "phpunit/phpunit": "^11.0"
    },
    "suggest": {
        "guzzlehttp/guzzle": "Cliente HTTP PSR-18 listo para usar (cualquier implementación PSR-18 vale)"
    },
    "autoload": {
        "psr-4": {
            "Pimia\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Pimia\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
